# Copy to `.env` for local Vite, or set the same names in the Amplify console.
# VITE_* values are public: they are inlined into the static bundle at build time.
# A new build is required after any value changes.

# Contact form (public, inlined at build time).
# JSON POST endpoint for the /ContactUs form, e.g. https://formspree.io/f/abcdwxyz
# Leave empty to fall back to a prefilled mailto: to sales@project8x.com.
VITE_CONTACT_ENDPOINT=
# Optional. Sent as "access_key" in the JSON body (Web3Forms requires it; Formspree does not).
VITE_CONTACT_ACCESS_KEY=
# Optional https:// scheduling link. Shows "Book an architect call" on /ContactUs when set.
VITE_BOOKING_URL=

# Cloudflare Web Analytics site token (public, inlined at build time).
# Unset = the beacon script is not added. Do not commit a real token.
# A new Amplify build is required after this changes.
VITE_CF_BEACON_TOKEN=

# News signup. https URL that accepts POST application/json
# { "email": "...", "source": "project8x.com/news" } and returns 2xx.
# http://localhost and http://127.0.0.1 are allowed for local adapters.
# Unset = the /news form stays disabled and says signup is coming soon.
# Do not put a newsletter API key here. VITE_ values ship in the browser bundle.
VITE_NEWS_SIGNUP_ENDPOINT=
