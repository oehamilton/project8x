# Build-time config for the /admin demo gate.
# Copy to `.env` for local Vite, or set the same names in the Amplify console.
# Keep these names. Do not rename them to VITE_*.
# vite.config.js reads them with loadEnv (empty prefix) and inlines them with
# define. import.meta.env only exposes VITE_* and would leave the hash empty.
# These are inlined into the static admin bundle at build time. They are NOT
# server-side secrets. The password hash is obfuscation, not authentication.
# A new build is required after either value changes.

# Lowercase SHA-256 hex of the shared passphrase. Hash it with no trailing newline.
# `echo passphrase | sha256sum` adds a newline, so the gate will say "Access denied."
# Use the node command (or `echo -n` / `printf '%s'`). Empty keeps the gate closed.
#   node -e "const c=require('crypto');process.stdout.write(c.createHash('sha256').update(process.argv[1]).digest('hex'))" 'your-passphrase'
ADMIN_PASSWORD_HASH=

# Published status JSON. The browser GETs this directly.
# live=true with demo_url=null shows the internal state (no Open demo).
# live=false, or a failed fetch, shows offline.
# This is the status document, not a demo host.
#
# Leave empty to use the published object:
#   https://agentforge-foundation-status.s3.us-east-1.amazonaws.com/demo/status.json
# AGENTFORGE_STATUS_URL is accepted when this name is unset.
#
# Local fixtures (no AgentForge required):
#   AGENTFORGE_DEMO_STATUS_URL=/fixtures/agentforge-status.live.json
#   AGENTFORGE_DEMO_STATUS_URL=/fixtures/agentforge-status.internal.json
#   AGENTFORGE_DEMO_STATUS_URL=/fixtures/agentforge-status.offline.json
AGENTFORGE_DEMO_STATUS_URL=
