# Build-time config for the /admin demo gate.
# Copy to `.env` for local Vite, or set the same names in the Amplify console.
# These are inlined into the static admin bundle at build time. They are NOT
# server-side secrets. The password hash is obfuscation, not authentication.
# A new build is required after either value changes.
#
# Leave both empty to ship a fail-closed gate and the offline demo state.

# Lowercase SHA-256 hex of the shared passphrase (no trailing newline in the input).
#   node -e "const c=require('crypto');process.stdout.write(c.createHash('sha256').update(process.argv[1]).digest('hex'))" 'your-passphrase'
ADMIN_PASSWORD_HASH=

# Where the site fetches AgentForge status JSON after the gate.
# Use an https URL in deployed environments. Do not commit a real demo host.
# Empty (or any fetch failure) shows the offline state.
#
# Local fixtures (no AgentForge required):
#   AGENTFORGE_STATUS_URL=/fixtures/agentforge-status.live.json
#   AGENTFORGE_STATUS_URL=/fixtures/agentforge-status.offline.json
#   AGENTFORGE_STATUS_URL=/fixtures/agentforge-status.expired.json
AGENTFORGE_STATUS_URL=
